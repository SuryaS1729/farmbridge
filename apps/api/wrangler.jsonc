{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-13",
	"vars": {
  "BETTER_AUTH_URL": "http://localhost:8787"
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "1abb5a1d6f024da795ac5a7300268cc0"
		}
	],
	"secrets": {
		"required": ["BETTER_AUTH_SECRET", "ADMIN_PHONE_NUMBER"]
	},
